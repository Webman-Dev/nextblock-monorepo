{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["jest.config.ts", "src/**/*.spec.ts", "test-setup.ts"],
  // This project is NOT composite (extends tsconfig.base.json), so sibling types resolve via
  // the path aliases and no "list all files" rule applies. Dropping the project references
  // avoids the TS6305 "output not built" noise the vite build can't satisfy.
  "references": []
}
